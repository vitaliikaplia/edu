{% extends "overall/base.twig" %}

{% block base %}

        <div class="course-hero">
            <span class="course-hero-icon">{{ course.icon }}</span>
            <h1>{{ course.title }}</h1>
            <p class="course-hero-desc">{{ course.description }}</p>
            <span class="course-card-meta">{{ lessons | length }} лекцій · ≈ {{ course.total_reading_time }} хв</span>
        </div>

        {% include 'overall/breadcrumbs.twig' %}

        <h2>Зміст курсу</h2>

        {% if lessons is defined and lessons | length > 0 %}
        <div class="lessons-list">
            {% for lesson in lessons %}
            <a href="{{ site.url }}{{ course.slug }}/{{ lesson.slug }}/" class="lesson-item">
                <span class="lesson-number">{{ lesson.number }}</span>
                <div class="lesson-body">
                    <span class="lesson-title">{{ lesson.title }}</span>
                    {% if lesson.description %}
                        <span class="lesson-desc">{{ lesson.description }}</span>
                    {% endif %}
                    <span class="lesson-meta">🕐 {{ lesson.reading_time }} хв</span>
                </div>
            </a>
            {% endfor %}
        </div>
        {% endif %}

{% endblock %}
