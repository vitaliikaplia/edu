{# --- WebSite schema (homepage) --- #}
{% if 'index' in body_classes %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "edu.kaplia.pro",
    "url": "{{ site.url }}",
    "description": "{{ page.description | default('') }}",
    "inLanguage": "uk",
    "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ site.url }}api/search/?q={search_term_string}",
        "query-input": "required name=search_term_string"
    }
}
</script>
{% endif %}

{# --- Course page (Course + ItemList) --- #}
{% if 'course-about' in body_classes and lessons is defined %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Course",
    "name": "{{ course.title }}",
    "description": "{{ course.description }}",
    "url": "{{ site.url }}{{ course.slug }}/",
    "provider": {
        "@type": "Organization",
        "name": "edu.kaplia.pro",
        "url": "{{ site.url }}"
    },
    "inLanguage": "uk",
    "numberOfLessons": {{ lessons | length }},
    "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "online",
        "courseWorkload": "PT{{ course.total_reading_time }}M"
    }
}
</script>
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "{{ course.title }} — зміст курсу",
    "numberOfItems": {{ lessons | length }},
    "itemListOrder": "https://schema.org/ItemListOrderAscending",
    "itemListElement": [
        {% for lesson in lessons %}
        {
            "@type": "ListItem",
            "position": {{ loop.index }},
            "url": "{{ site.url }}{{ course.slug }}/{{ lesson.slug }}/",
            "name": "{{ lesson.title }}"
        }{% if not loop.last %},{% endif %}

        {% endfor %}
    ]
}
</script>
{% endif %}

{# --- Lesson page (Article) --- #}
{% if 'course-lesson' in body_classes and lesson is defined %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ lesson.title }}",
    "description": "{{ page.description | default('') }}",
    "url": "{{ page.canonical | default('') }}",
    "inLanguage": "uk",
    "position": {{ lesson_current | default(1) }},
    "isPartOf": {
        "@type": "Course",
        "name": "{{ course.title }}",
        "url": "{{ site.url }}{{ course.slug }}/"
    },
    "author": {
        "@type": "Person",
        "name": "Віталій Капля",
        "url": "https://vitaliikaplia.com/"
    },
    "publisher": {
        "@type": "Organization",
        "name": "edu.kaplia.pro",
        "url": "{{ site.url }}"
    },
    "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ page.canonical | default('') }}"
    },
    "wordCount": {{ (reading_time | default(1)) * 200 }},
    "timeRequired": "PT{{ reading_time | default(1) }}M"
}
</script>
{% endif %}
